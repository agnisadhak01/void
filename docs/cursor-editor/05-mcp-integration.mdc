    subgraph "Cursor Agent"
        A[Main Agent]
        A -->|CallMcpTool| B[CallMcpTool]
        A -->|FetchMcpResource| C[FetchMcpResource]
        A -->|ListMcpResources| D[ListMcpResources]
    end
    
