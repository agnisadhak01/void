      // Block network requests by default
      "blockNetworkRequests": true,
      
      // Require approval for all shell commands
      "requireApprovalForShell": true,
      
      // Audit all agent actions
      "auditLogEnabled": true,
      "auditLogRetentionDays": 365
    }
  }
}
```

