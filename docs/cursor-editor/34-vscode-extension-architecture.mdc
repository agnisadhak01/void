├── cursor-resolver             # Layer 2: Cloud remote authority resolver
├── cursor-resolver-helper      # Layer 2: Connection token provider
├── cursor-retrieval            # Layer 3: Codebase indexing & search
├── cursor-shadow-workspace     # Layer 6: Virtual workspace abstraction
