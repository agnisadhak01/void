  function selectChatModels(filter?: LanguageModelChatSelector): LanguageModelChat[];
  
  // Register custom LLM tools
  function registerTool<T extends LanguageModelToolInvocationOptions>(
    name: string,
    tool: LanguageModelTool<T>
