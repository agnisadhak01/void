## Composer Webview Architecture

The **Composer** is Cursor's AI chat/browser feature. It runs as a webview with a custom preload script providing IPC communication with the Electron main process.

### Webview Preload Script

`out/vs/workbench/contrib/composer/browser/preload-webview-browser.js` is the critical file that bridges the Composer webview to the Electron host.

**Four Main Components**:

#### 1. Local Network Access Polyfill

```javascript
// Polyfills navigator.permissions.query for 'local-network-access'
// Always returns { state: 'granted' } for these permissions
// Skipped for known auth providers: Okta, Duo, Microsoft, Auth0, PingIdentity, Rippling
function polyfillLocalNetworkAccess() {
  const originalQuery = navigator.permissions.query;
  navigator.permissions.query = function(desc) {
    if (desc.name === 'local-network-access' || desc.name === 'local-network') {
      return Promise.resolve({ state: 'granted' });
    }
    return originalQuery.call(this, desc);
  };
}
```

#### 2. WebAuthn/Passkey Polyfill

```javascript
// Overrides navigator.credentials.create and navigator.credentials.get
// Handles timeout: 10s before notifying host, 45s before aborting
function polyfillWebAuthn() {
  const originalCreate = navigator.credentials.create;
  const originalGet = navigator.credentials.get;
  
  navigator.credentials.create = async function(opts) {
    // 10s timeout warning
    setTimeout(() => window.cursorBrowser.send('passkey-request-stalled'), 10000);
    try {
      return await originalCreate.call(this, opts);
    } catch (e) {
      if (e.name === 'TimeoutError') {
        window.cursorBrowser.send('passkey-request-stalled');
      }
      throw e;
    }
  };
  
  // 45s hard timeout
  const timeout = setTimeout(() => {
    window.cursorBrowser.send('passkey-request-stalled');
  }, 45000);
  
  navigator.credentials.get = async function(opts) {
    clearTimeout(timeout);
    return originalGet.call(this, opts);
  };
  
  // Platform auth availability always returns false
  PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable = () =>
    Promise.resolve(false);
}
```

#### 3. Native Dialog Override

```javascript
// Overrides alert(), confirm(), prompt() in webview
function overrideNativeDialogs() {
  window.alert = function(msg) {
    console.log('[Webview] alert:', msg);
    return undefined;
  };
  
  window.confirm = function(msg) {
    return true; // Always returns true to avoid blocking
  };
  
  window.prompt = function(msg, defaultValue) {
    return defaultValue ?? null; // Returns defaultValue
  };
}
```

#### 4. cursorBrowser IPC Bridge

```javascript
// Exposed as window.cursorBrowser via contextBridge
const cursorBrowser = {
  send(type, payload) {
    ipcRenderer.sendToHost(type, payload);
  }
};
```

